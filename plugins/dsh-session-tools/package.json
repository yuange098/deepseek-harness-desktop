{
  "name": "dsh-session-tools",
  "version": "1.0.0",
  "private": true,
  "description": "会话管理增强：左侧会话列表每行加「删除对话」按钮，二次确认后删除该对话的全部记录数据（消息、轨迹、代码归档、投影缓存）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
