# 依赖与构建产物
node_modules/
dist/
*.tgz

# 运行期数据（会话、日志、缓存、探针临时目录）
home/
logs/
workspace/
.probe-work/
.electron-scratch*/
*.log

# Python
__pycache__/
*.pyc

# 私人数据文件：一律不入库（Word / Excel / PPT / PDF / 数据 / 压缩包 / 图片素材）
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.pdf
*.rtf
*.odt
*.ods
*.csv
*.tsv
*.txt
*.jsonl
*.db
*.sqlite
*.sqlite3
*.zip
*.rar
*.7z
*.tar
*.gz
*.bak
*.tmp

# 保留：说明文档与示例配置
!README.md
!CHANGELOG.md
!LICENSE
!docs/*.md
!desktop/config.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
